#write.csv(mse_change, "result_mse_change.csv")
df = 999
low = (1 - qf(1-0.05/2, df,df))*100
high = (1 - qf(0.05/2, df,df))*100
mse_change |>
mutate(method = case_when(
method == "tau_lasso" ~ "Lasso",
method == "tau_bart" ~ "Bart"))|>
ggplot(
aes(x = method,
y = as.numeric(change),
fill  = method))+
geom_bar(stat = "identity", position = position_dodge(), width = 0.5) +
facet_grid(. ~ set_up ) +
geom_hline(yintercept = high, color = "chartreuse4", linetype = "dashed", linewidth = 0.5) +
geom_hline(yintercept = low, color = "darkred", linetype = "dashed", linewidth = 0.5) +
geom_hline(yintercept = 0, linewidth = 0.2) + #  +
labs(x = "Method",
y = "% improvement in MSE",
fill = "Method:",
title = "% Improvement in MSE ",
subtitle = "ReM compared to Difference in Means") +
theme_minimal() +
theme(
legend.position = "bottom",
strip.text = element_text(size = 12, face = "bold"),
panel.border = element_rect(color = "darkgray", fill = NA, linewidth  = 0.3),
panel.grid.major.x = element_blank(),
panel.grid.minor.x = element_blank(),
title = element_text(size = 14),
axis.text = element_text(size = 12),         # Size of tick values
axis.title = element_text(size = 12),
legend.text = element_text(size = 10),
legend.title = element_text(size = 12)
)
