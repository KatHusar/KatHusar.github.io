library(tidyr)
library(dplyr)
library(tidyverse)
mse_change = data.frame(matrix(ncol = 4, nrow = 0))
colnames(mse_change) <- c("change","method", "set_up")
result_linear <- read_csv("linear/linear_p1000.csv",show_col_types = FALSE,
col_select = -1)
p = 1000
colnames(result_linear) <- c(
"tau_bart",
"tau_diff_in_means",
"tau_lasso",
"count_bart",
"count_lasso",
paste0("alpha_bart_", 1:p),
paste0("beta_bart_", 1:p),
paste0("visit_times_bart_", 1:p),
paste0("alpha_lasso_", 1:p),
paste0("beta_lasso_", 1:p),
paste0("visit_times_lasso_", 1:p)
)
result_linear_long <- result_linear |>
pivot_longer(cols = c("tau_bart", "tau_diff_in_means", "tau_lasso"), names_to = "method")
ggplot(result_linear_long) +
geom_boxplot(aes( x=value, y = method )) +
geom_vline(aes(xintercept = 4, color = "True TE"), alpha = 1) +
theme_bw()  +
theme(legend.position = "none")
mse_linear <- result_linear_long |>
group_by(method) |>
summarise(m = mean(value),
v = var(value),
mse = v + (m - 4)^2,
q1 = quantile(value, 0.25),
med = median(value)) |>
arrange(mse)
mse_linear
mse_diff_linear<- mse_linear[mse_linear$method == "tau_diff_in_means",]$mse
for(method in c("tau_lasso",
"tau_bart")){
mse_method = mse_linear[mse_linear$method == method, ]$mse
change = (mse_diff_linear - mse_method)/mse_diff_linear*100
mse_change= rbind(mse_change,
c(change, method, "linear"))
colnames(mse_change) <- c("change","method", "set_up")
}
alpha_cols_bart  <- paste0("alpha_bart_", 1:p)
alpha_cols_lasso <- paste0("alpha_lasso_", 1:p)
