geom_boxplot(outlier.alpha = 0.1) +
theme_minimal() +
labs(x = "Variable Index", y = "Alpha Estimate",
title = "Distribution of Alpha Estimates Across Monte Carlo Runs") +
theme(axis.text.x = element_text(angle = 90, hjust = 1))
library(ggridges)
