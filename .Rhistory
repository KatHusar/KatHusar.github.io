aes(x = alpha, y = factor(var), fill = method)) +
geom_density_ridges(alpha = 0.8, scale = 2, rel_min_height = 0.01) +
theme_ridges() +
labs(x = "Alpha", y = "Variable",
title = "Alpha Distributions — Bart vs Lasso")
stats_alpha <- df_alpha_long %>%
group_by(var, method) %>%
summarize(mean_alpha = mean(alpha), .groups = "drop")
